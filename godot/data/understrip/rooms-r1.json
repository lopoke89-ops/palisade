    "#": {"what": "tunnel wall: solid, stops bullets and sight", "terrain": "T_CONC (new in M1; T_ROCK until it exists)"},
    "%": {"what": "concrete pillar: solid, stops bullets and sight (free-standing, drawn as a pillar)", "terrain": "T_CONC"},
    "o": {"what": "low cover (a dumped slot machine, a crate): solid, bullets pass over", "terrain": "T_DRUM"},
    ".": {"what": "dry floor", "terrain": "T_GROUND"},
    ",": {"what": "low floor: goes under in a flash flood (Riverbend's T_LOW rules)", "terrain": "T_LOW"},
    "~": {"what": "drain channel: water, half speed", "terrain": "T_WATER"},
    "=": {"what": "grate bridge over the channel: dry", "terrain": "T_BRIDGE"},
    "D": {"what": "doorway: two tiles on a cell edge, at the door slots. Unused doorways are sealed with wall by the generator", "terrain": "T_GROUND"},
    "G": {"what": "boss gate doorway: like D, seals once a player steps through", "terrain": "T_GROUND"},
    "K": {"what": "shortcut door: solid until opened from its opensFrom side, then floor for the rest of the run", "terrain": "T_CONC, then T_GROUND"},
    "P": {"what": "player start spot (one per player, up to six)", "terrain": "T_GROUND"},
    "E": {"what": "exit ring centre (the freight lift)", "terrain": "T_GROUND"},
    "S": {"what": "Neon Shrine", "terrain": "T_GROUND"},
    "M": {"what": "merchant", "terrain": "T_GROUND"},
    "C": {"what": "chest", "terrain": "T_GROUND"},
    "A": {"what": "ambush spot: a raider waits here, in the dark, until a player passes", "terrain": "T_GROUND"},
    "B": {"what": "boss spawn", "terrain": "T_GROUND"},
    "L": {"what": "work lamp: a fixed warm light, radius 3", "terrain": "T_GROUND"},
    "n": {"what": "neon through a grate: a fixed pink-blue light, radius 2, flickering", "terrain": "T_GROUND"}
  },
  "rules": [
    "Grids are rows of tiles, north row first. A piece is size[0] x size[1] cells of 8 x 8 tiles.",
    "Edges are wall except doorways, which sit in pairs at tiles 3 and 4 of a cell edge, so any two pieces join.",
    "rotate: the generator may turn the piece by 90, 180 or 270 degrees and mirror it (markers and opensFrom turn with it).",
    "weight: how often the generator picks it among pieces that fit. max: at most this many in one level.",
    "Corridor and junction pieces are never more than two tiles wide (no 3 x 3 open square). The checker enforces it."
  ],
